# Postgres connection. In docker-compose this is assembled from the
# POSTGRES_* vars below; set it directly for local (non-Docker) development.
DATABASE_URL=postgres://user:password@localhost:5432/hourglass

# Used by the postgres container in docker-compose.yml.
POSTGRES_USER=hourglass
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hourglass

# The canonical public URL this app is served at. Used for CSRF Origin
# checks and for building absolute links (manage links, share links).
# No trailing slash.
APP_ORIGIN=http://localhost:3000

# 32+ byte random secret. Used as the HMAC pepper for hashing bearer tokens
# and as the signing key for the view-password / host-password session
# cookies. Generate with: openssl rand -base64 32
# Rotating this invalidates every active session and bearer token.
TOKEN_PEPPER=

# How many days a deleted poll is kept (soft-deleted) before being purged
# for good.
DELETE_GRACE_DAYS=30

# Public domain for the optional Caddy reverse proxy in docker-compose.yml
# (self-hosted deployment only — irrelevant for local dev).
DOMAIN=example.com

# Host-side port the `app` container is published on, bound to 127.0.0.1
# only (never the public internet) — point your own reverse proxy /
# control panel (CloudPanel, nginx, ...) at this port. Irrelevant if you're
# using the bundled Caddy instead (`--profile caddy`).
APP_PORT=3100
